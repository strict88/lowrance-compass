; Copy this file to secrets.ini (git-ignored) and fill in real values.
; Used by tools/hil/http_status_check.py and tools/hil/ssid_change_check.py to
; join the bench Wi-Fi network and reach the device by IP in Station mode
; (quickstart.md section 7), instead of the device's own Access Point.

[bench_wifi]
ssid = YOUR_BENCH_WIFI_SSID
password = YOUR_BENCH_WIFI_PASSWORD

[device]
; IP address the device receives from the bench network's DHCP server.
host = 192.168.1.100
